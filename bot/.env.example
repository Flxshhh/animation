# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ с https://platform.claude.com/ (Settings → API keys)
ANTHROPIC_API_KEY=

# Твой Telegram id (узнать: напиши боту, он покажет). Через запятую, если несколько.
# Пусто — бот отвечает всем, и все тратят твои деньги на API.
ALLOWED_USERS=

# Необязательные настройки
CLAUDE_MODEL=claude-opus-5-5
# low — быстрее ответ; medium/high — дольше думает, точнее разбор ошибок
CLAUDE_EFFORT=low
# tiny / base / small / medium — чем больше, тем точнее и медленнее
WHISPER_MODEL=small
# en — распознавать как английский; пусто — определять язык автоматически
WHISPER_LANGUAGE=en
# Голоса: edge-tts --list-voices | grep en-
TTS_VOICE=en-US-AriaNeural
TTS_RATE=-5%

# Мини-приложение «Текст» (нажал на слово — перевод и 🔖 в словарь).
# Telegram открывает мини-приложения только по https. Для запуска на своём компьютере:
#   cloudflared tunnel --url http://localhost:8080
# и впиши сюда адрес, который он напечатает (https://….trycloudflare.com).
# Пусто — кнопка «Текст» просто покажет текст в подписи к голосовому.
WEBAPP_URL=
WEBAPP_PORT=8080
